<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Pondhawk.Waf.CoreRuleSet</RootNamespace>
    <Description>The OWASP Core Rule Set (CRS) v4.30.0, embedded for the Pondhawk WAF engine, with the official CRS rule exclusion plugins. CRS is Apache-2.0 licensed.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="crs/**/*.conf;crs/**/*.data;crs/crs-setup.conf.example;crs/VERSION;pondhawk/*.conf" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- CRS plugins, flattened to plugins/<name>-<stage>.conf as CRS installs them. -->
    <EmbeddedResource Include="plugins/*/*.conf;plugins/VERSIONS" LogicalName="plugins/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pondhawk.Waf\Pondhawk.Waf.csproj" />
  </ItemGroup>
</Project>
